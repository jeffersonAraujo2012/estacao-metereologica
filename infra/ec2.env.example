# Guardar em /opt/estacao-api/.env no servidor, nunca no Git.
# Nome EXATO da rede Docker à qual o MongoDB já pertence:
EXTERNAL_DOCKER_NETWORK=nome-da-rede-existente
# Host interno do contêiner MongoDB na rede compartilhada:
MONGODB_URI=mongodb://nome-servico-mongo:27017
MONGODB_DATABASE=nome-real-do-banco
MONGODB_COLLECTION=nome-real-da-colecao
CORS_ORIGINS=http://localhost:5173
# Na EC2, IMAGE é passado pelo workflow de deploy.
